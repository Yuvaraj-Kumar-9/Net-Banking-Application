# ---------------------------------------------------------------------------
# HFDC Bank - copy to .env (or export these variables in your shell).
# NEVER commit a filled-in .env file. Production secrets are supplied by the
# hosting provider's dashboard, not by a file in the repository.
# ---------------------------------------------------------------------------

# Backend (Spring Boot)
PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:33306/hfdc_bank?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USER=hfdc_user
DB_PASSWORD=change_me
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
DEV_MODE=true

# Frontend (Vite). The default /api works in both modes:
#  - development: Vite proxies /api to http://localhost:8080
#  - production: the Spring Boot jar serves the UI and API on the same origin
# Set this only when the frontend is hosted separately from the backend.
VITE_API_URL=/api
